rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net - default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Submissions collection validation
    function isValidSubmission(data) {
      return data.keys().hasAll(['toolName', 'vendorUrl', 'pricingUrl', 'category', 'submissionType', 'contactEmail', 'createdAt'])
        && data.toolName is string && data.toolName.size() > 0 && data.toolName.size() <= 100
        && data.vendorUrl is string && data.vendorUrl.size() > 0 && data.vendorUrl.size() <= 300
        && data.pricingUrl is string && data.pricingUrl.size() > 0 && data.pricingUrl.size() <= 300
        && data.category is string && data.category.size() > 0 && data.category.size() <= 50
        && (data.submissionType == 'standard' || data.submissionType == 'sponsor')
        && data.contactEmail is string && data.contactEmail.size() > 0 && data.contactEmail.size() <= 150
        && data.createdAt is string;
    }

    match /submissions/{submissionId} {
      allow create: if isValidId(submissionId) && isValidSubmission(incoming());
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    // User bookmarks / saved tools
    match /users/{userId}/savedTools/{toolId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidId(toolId);
    }
  }
}
